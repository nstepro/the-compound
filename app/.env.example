# Copy to .env and fill in real values. DO NOT commit .env.
# See documentation/ENVIRONMENT_VARIABLES.md for full reference.

# Frontend
VITE_MAPBOX_ACCESS_TOKEN=your_mapbox_token_here

# Google APIs
GOOGLE_PLACES_API_KEY=your_places_api_key
GOOGLE_DOC_ID=your_google_doc_id
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json

# OpenAI (parser)
OPENAI_API_KEY=your_openai_api_key

# Security (generate hashes: node utilities/generate-password.js admin|guest)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-make-it-long-and-random
ADMIN_PASSWORD_HASH=your_bcrypt_admin_hash
GUEST_PASSWORD_HASH=your_bcrypt_guest_hash

# Rate limiting (optional)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_ATTEMPTS=5

# Google Cloud Storage (optional; set GOOGLE_CLOUD_STORAGE_ENABLED=false for local-only files)
GOOGLE_CLOUD_STORAGE_BUCKET=compound-places-storage
GOOGLE_CLOUD_STORAGE_FILE_NAME=compound-places.json
GOOGLE_CLOUD_STORAGE_ENABLED=true

# Server (optional)
# PORT=3000
# LOG_LEVEL=info
# NODE_ENV=development
